{
  "name": "agent-course",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "动手学 Agent(provider 中立 · TS)—— 习得导向,不是照抄",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test chapters/*/*.test.ts",
    "test:01": "node --test chapters/01/agent.test.ts",
    "demo:01": "node chapters/01/demo.ts",
    "test:02": "node --test chapters/02/adapter.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run typecheck && npm run lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
